# vim: filetype=neomuttrc
set my_cfg_dir = "~/.config/neomutt"

source $my_cfg_dir/settings
source $my_cfg_dir/bindings
source $my_cfg_dir/macros
source $my_cfg_dir/colors

# Mail account: the mirror in ~/Mail/Fastmail (see ~/.mbsyncrc)
source $my_cfg_dir/fastmail

# Full-text search across every folder (only if neomutt was built with notmuch)
ifdef notmuch 'source ~/.config/neomutt/notmuch'
