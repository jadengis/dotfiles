# vim: filetype=neomuttrc

# Write mail in neovim
set editor = "nvim"

set real_name = "John Dengis"

# Prefer HTML, rendered as text through the copiousoutput entry in mailcap
auto_view text/html
alternative_order text/html text/plain text/enriched text/*
set allow_ansi                       # elinks renders HTML with colour codes

# Main options
set mbox_type = Maildir
set mail_check_stats
set use_envelope_from
set sendmail = "msmtp"
set fast_reply
set askcc                            # ask for CC:
set fcc_attach                       # save attachments with the body
unset wait_key                       # only pause after a shell command fails

set reply_to
set reverse_name                     # reply with name from inbound email

set include
set forward_format = "Fwd: %s"       # format of subject when forwarding
set forward_decode
set forward_quote

set sort = threads                   # sort mail in threads
set sort_aux = reverse-last-date-received
set charset = "utf-8"
set markers = no
set smart_wrap = no

set mailcap_path = ~/.config/neomutt/mailcap
set header_cache = "~/.cache/neomutt/"

# Index
set index_format = "%4C %Z %{%b %d, %Y} %-20.20L %-40.40a (%?l?%4l&%4c?) %s"
set auto_tag = yes

# Pager
set pager_context = 3
set pager_index_lines = 20

# Sidebar: show INBOX.PlanEngine as an indented "PlanEngine" under INBOX
set sidebar_visible
set sidebar_format = "%B%?F? [%F]?%* %?N?%N/?%S"
set sidebar_short_path
set sidebar_delim_chars = "."
set sidebar_folder_indent
set sidebar_indent_string = "  "
