# vim:filetype=msmtp
# The app password lives in pass, not in this public repo.

defaults
auth           on
tls            on
logfile        ~/.local/state/msmtp.log

account        fastmail
host           smtp.fastmail.com
port           465
tls_starttls   off
user           john@deng.is
from           john@deng.is
passwordeval   pass show Mail/Fastmail/AppPassword

account default : fastmail
