#!/usr/bin/env python3
"""Unsubscribe from the mailing list a message came from.

neomutt pipes the raw message in (Alt-U). Reads its List-Unsubscribe header
and, after asking, does the first of these the sender supports:

  1. one-click (RFC 8058): an HTTPS POST, nothing else needed
  2. mailto: sends the unsubscribe email with msmtp
  3. a web link: opens the unsubscribe page in the browser
"""
import email
import email.policy
import re
import subprocess
import sys
from email.message import EmailMessage
from urllib.parse import parse_qs, unquote, urlsplit

# stdin is the message, so talk to the terminal directly
tty_in = open("/dev/tty")
tty_out = open("/dev/tty", "w")


def say(text=""):
    tty_out.write(text + "\n")
    tty_out.flush()


def ask(question):
    tty_out.write(f"{question} [y/N] ")
    tty_out.flush()
    return tty_in.readline().strip().lower() in ("y", "yes")


def done(code=0):
    tty_out.write("\nPress Enter to go back to neomutt ")
    tty_out.flush()
    tty_in.readline()
    sys.exit(code)


def one_click(url):
    result = subprocess.run(
        ["curl", "--silent", "--show-error", "--max-time", "30", "--proto", "=https",
         "--output", "/dev/null", "--write-out", "%{http_code}",
         "--data", "List-Unsubscribe=One-Click", url],
        capture_output=True, text=True)
    status = result.stdout.strip()
    if result.returncode == 0 and status.startswith("2"):
        say(f"Unsubscribed (the server answered {status}).")
        return True
    say(f"The one-click unsubscribe failed: {result.stderr.strip() or 'HTTP ' + status}")
    return False


def send_mail(uri):
    parts = urlsplit(uri)
    query = {k.lower(): v[0] for k, v in parse_qs(parts.query).items()}
    msg = EmailMessage()
    msg["To"] = unquote(parts.path)
    msg["Subject"] = query.get("subject", "unsubscribe")
    msg.set_content(query.get("body", "unsubscribe"))
    # msmtp adds From, Date and Message-ID from ~/.msmtprc
    result = subprocess.run(["msmtp", "-t"], input=msg.as_bytes(), capture_output=True)
    if result.returncode == 0:
        say(f"Sent the unsubscribe email to {msg['To']}.")
        return True
    say(f"msmtp failed: {result.stderr.decode(errors='replace').strip()}")
    return False


def open_page(url):
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    say("Opened the unsubscribe page in your browser; finish there.")


def main():
    msg = email.message_from_binary_file(sys.stdin.buffer, policy=email.policy.default)
    sender = str(msg.get("From", "this sender"))
    header = re.sub(r"\s+", "", str(msg.get("List-Unsubscribe", "")))
    # <uri>, <uri>; some senders leave out the brackets
    uris = re.findall(r"<([^>]+)>", header) or header.split(",")
    https = next((u for u in uris if u.lower().startswith("https://")), None)
    mailto = next((u for u in uris if u.lower().startswith("mailto:")), None)
    web = https or next((u for u in uris if u.lower().startswith("http://")), None)
    post = str(msg.get("List-Unsubscribe-Post", "")).replace(" ", "").lower()

    say(f"From:  {sender}")
    if not (web or mailto):
        say("This message has no unsubscribe header.")
        say("Use Ctrl-b to find an unsubscribe link in the message itself.")
        done(1)

    if https and post == "list-unsubscribe=one-click":
        say(f"Via:   one-click unsubscribe at {urlsplit(https).hostname}")
        if not ask("Unsubscribe?"):
            done()
        if one_click(https):
            done()
        say("Trying the other way instead.\n")
    if mailto:
        say(f"Via:   an email to {unquote(urlsplit(mailto).path)}")
        if ask("Send it?"):
            done(0 if send_mail(mailto) else 1)
    elif web:
        say(f"Via:   the web page at {urlsplit(web).hostname}")
        if ask("Open it?"):
            open_page(web)
    done()


if __name__ == "__main__":
    main()
