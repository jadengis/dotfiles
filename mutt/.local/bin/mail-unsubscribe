#!/usr/bin/env python3
"""Unsubscribe from the mailing list a message came from, inside neomutt.

Alt-U copies the message to an mbox file and runs
:echo "`mail-unsubscribe FILE`", so this prints one line for neomutt's status
line instead of talking to the terminal, and neomutt never leaves the screen
(unlike <pipe-message> or `source "cmd |"`).

The first Alt-U on a message says what it would do; pressing Alt-U again on
the same message within a minute does the first of these the sender supports,
falling back to the next if it fails:

  1. one-click (RFC 8058): an HTTPS POST, nothing else needed
  2. mailto: sends the unsubscribe email with msmtp
  3. a web link: opens the unsubscribe page in the browser
"""
import email
import email.policy
import hashlib
import json
import mailbox
import os
import re
import subprocess
import sys
import time
from email.message import EmailMessage
from email.utils import parseaddr
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

CONFIRM_SECONDS = 60
STATE = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "mail-unsubscribe.json"


def echo(text):
    """Print text for neomutt's status line (one line, shown as is)."""
    print(re.sub(r"\s+", " ", text).strip(), end="")


def read_message(path):
    path = Path(path).expanduser()
    box = mailbox.Maildir(path, create=False) if path.is_dir() else mailbox.mbox(path)
    try:
        keys = list(box.keys())
        if not keys:
            return None
        raw = box.get_bytes(keys[-1])
    finally:
        box.close()
        if path.is_dir():
            subprocess.run(["rm", "-rf", str(path)])
        else:
            path.unlink(missing_ok=True)
    return email.message_from_bytes(raw, policy=email.policy.default)


def one_click(url):
    result = subprocess.run(
        ["curl", "--silent", "--show-error", "--max-time", "20", "--proto", "=https",
         "--output", "/dev/null", "--write-out", "%{http_code}",
         "--data", "List-Unsubscribe=One-Click", url],
        capture_output=True, text=True)
    status = result.stdout.strip()
    if result.returncode == 0 and status.startswith("2"):
        return None
    return result.stderr.strip() or f"HTTP {status}"


def send_mail(uri):
    parts = urlsplit(uri)
    query = {k.lower(): v[0] for k, v in parse_qs(parts.query).items()}
    msg = EmailMessage()
    msg["To"] = unquote(parts.path)
    msg["Subject"] = query.get("subject", "unsubscribe")
    msg.set_content(query.get("body", "unsubscribe"))
    # msmtp adds From, Date and Message-ID from ~/.msmtprc
    result = subprocess.run(["msmtp", "-t"], input=msg.as_bytes(), capture_output=True)
    if result.returncode == 0:
        return None
    return result.stderr.decode(errors="replace").strip() or "msmtp failed"


def open_page(url):
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    subprocess.Popen([opener, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def confirmed(key):
    """True if this is the second Alt-U on the same message, in time."""
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    if state.get("key") == key and time.time() - state.get("time", 0) < CONFIRM_SECONDS:
        STATE.unlink(missing_ok=True)
        return True
    STATE.write_text(json.dumps({"key": key, "time": time.time()}))
    return False


def main():
    msg = read_message(sys.argv[1])
    if msg is None:
        return echo("Unsubscribe: no message to read")

    name, addr = parseaddr(str(msg.get("From", "")))
    sender = name or addr or "this sender"
    header = re.sub(r"\s+", "", str(msg.get("List-Unsubscribe", "")))
    # <uri>, <uri>; some senders leave out the brackets
    uris = re.findall(r"<([^>]+)>", header) or header.split(",")
    https = next((u for u in uris if u.lower().startswith("https://")), None)
    mailto = next((u for u in uris if u.lower().startswith("mailto:")), None)
    web = https or next((u for u in uris if u.lower().startswith("http://")), None)
    post = str(msg.get("List-Unsubscribe-Post", "")).replace(" ", "").lower()

    ways = []
    if https and post == "list-unsubscribe=one-click":
        ways.append(("one-click", https))
    if mailto:
        ways.append(("email", mailto))
    if web:
        ways.append(("web", web))
    if not ways:
        return echo(f"{sender} has no unsubscribe header; use Ctrl-b to find a link in the message")

    describe = {
        "one-click": lambda u: f"one click at {urlsplit(u).hostname}",
        "email": lambda u: f"emailing {unquote(urlsplit(u).path)}",
        "web": lambda u: f"opening {urlsplit(u).hostname} in the browser",
    }
    key = str(msg.get("Message-ID") or hashlib.sha1(header.encode()).hexdigest())
    if not confirmed(key):
        how, uri = ways[0]
        return echo(f"Unsubscribe from {sender} by {describe[how](uri)}? Press Alt-U again to confirm")

    errors = []
    for how, uri in ways:
        if how == "one-click":
            error = one_click(uri)
        elif how == "email":
            error = send_mail(uri)
        else:
            open_page(uri)
            return echo(f"Opened the unsubscribe page for {sender}; finish it in the browser")
        if error is None:
            done = "Unsubscribed from" if how == "one-click" else "Sent the unsubscribe email to"
            return echo(f"{done} {sender}")
        errors.append(f"{how}: {error}")
    echo(f"Could not unsubscribe from {sender} ({'; '.join(errors)})")


if __name__ == "__main__":
    # keep stray errors off neomutt's screen
    sys.stderr = open(os.devnull, "w")
    try:
        main()
    except Exception as e:  # noqa: BLE001 -- show it in neomutt rather than crash silently
        echo(f"Unsubscribe failed: {e}")
