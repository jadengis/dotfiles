#!/bin/sh
# Print every maildir folder under $1 as quoted neomutt mailbox names, INBOX
# and its subfolders first ("=INBOX" "=INBOX.PlanEngine" "=Archive" ...), so
# the sidebar nests them under INBOX. Used by `mailboxes`.
cd "$1" 2>/dev/null || exit 0
for pass in inbox rest; do
    for d in */; do
        d=${d%/}
        [ -d "$d/cur" ] || continue
        case $d in INBOX | INBOX.*) [ $pass = inbox ] ;; *) [ $pass = rest ] ;; esac || continue
        printf '"=%s" ' "$d"
    done
done
